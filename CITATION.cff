    alias: donbr
    website: https://github.com/donbr/sprime-lung-repro
repository-code: https://github.com/donbr/sprime-lung-repro
url: https://github.com/donbr/sprime-lung-repro
license: MIT
keywords:
  - synthetic lethality
  - lung cancer
  - pharmacogenomics
  - drug response
  - PRISM
  - DepMap
  - reproducibility
  - computational biology
